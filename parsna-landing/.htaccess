# Ashna static product preview; Apache 2.4 with mod_headers/mod_rewrite.
Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Behind a reverse proxy, configure trusted HTTPS detection at the virtual host.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(php|py|zip|asp|aspx|jsp|cgi)$ - [F,L,NC]
</IfModule>
<FilesMatch "^(\.|serve\.py|.*\.zip$)">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # No preload/includeSubDomains: deployment owner controls other hosts.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
  <FilesMatch "\.(css|js|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
